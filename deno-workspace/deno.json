{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["deno.ns", "deno.window"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["**/tests/**"]
    }
  },
  "fmt": {
    "options": {
      "lineWidth": 80,
      "indentWidth": 2
    }
  },
  "tasks": {
    "build": {
      "script": "deno run --allow-all src/mod.ts"
    }
  }
}